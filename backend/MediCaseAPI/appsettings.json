{
  "ConnectionStrings": {
    "MedicalDatabase": "Host=localhost;Port=5432;Database=medicase;Username=medicase",
    "PublishedDatabase": "Host=localhost;Port=5432;Database=medicase_published;Username=medicase"
  },
  "Cognito": {
    "Region": "eu-central-1",
    "UserPoolId": "",
    "ClientId": ""
  },
  "AWS": {
    "Region": "eu-central-1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "Files",
    "KeyPrefix": "files/",
    "MaxFileSizeMb": 20,
    "UnusedFileGracePeriodMinutes": 60,
    "AllowedContentTypes": [
      "audio/mpeg",
      "audio/wav",
      "audio/ogg",
      "image/png",
      "image/jpeg",
      "image/gif"
    ]
  },
  "Speech": {
    "Engine": "standard",
    "MaxCharacters": 3000,
    "Voices": {
      "pl": "Ewa",
      "en": "Joanna",
      "de": "Marlene",
      "fr": "Celine",
      "es": "Lucia"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
