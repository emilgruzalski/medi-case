{
  "ConnectionStrings": {
    "MedicalDatabase": "Server=(localdb)\\mssqllocaldb;Database=Premedical;Trusted_Connection=True;TrustServerCertificate=True",
    "PublishedDatabase": "Server=(localdb)\\mssqllocaldb;Database=PremedicalPublished;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Sessions": {
    "LifetimeHours": 12,
    "TokenBytes": 32
  },
  "FileStorage": {
    "RootPath": "Files",
    "MaxFileSizeMb": 20,
    "AllowedContentTypes": [
      "audio/mpeg",
      "audio/wav",
      "audio/ogg",
      "image/png",
      "image/jpeg",
      "image/gif"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
