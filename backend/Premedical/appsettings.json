{
  "ConnectionStrings": {
    "MedicalDatabase": "Server=(localdb)\\mssqllocaldb;Database=Premedical;Trusted_Connection=True;TrustServerCertificate=True",
    "PublishedDatabase": "Server=(localdb)\\mssqllocaldb;Database=PremedicalPublished;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Sessions": {
    "LifetimeHours": 12,
    "TokenBytes": 32
  },
  "AWS": {
    "Region": "eu-central-1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "FileStorage": {
    "RootPath": "Files",
    "MaxFileSizeMb": 20,
    "UnusedFileGracePeriodMinutes": 60,
    "AllowedContentTypes": [
      "audio/mpeg",
      "audio/wav",
      "audio/ogg",
      "image/png",
      "image/jpeg",
      "image/gif"
    ]
  },
  "Speech": {
    "Engine": "standard",
    "MaxCharacters": 3000,
    "Voices": {
      "pl": "Ewa",
      "en": "Joanna",
      "de": "Marlene",
      "fr": "Celine",
      "es": "Lucia"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
